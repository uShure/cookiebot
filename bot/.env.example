# Telegram bot token from @BotFather. NEVER commit the real one.
BOT_TOKEN=

# Public URL of the CookieBot web app (Nightly wallet actions: send, tip, swap).
WEB_APP_URL=http://localhost:5173

# Cookie Chain endpoints (defaults are the public community endpoints).
COOKIE_RPC_URL=https://rpc.cookiescan.io
COOKIE_WS_URL=wss://rpc.cookiescan.io
COOKIESCAN_API_URL=https://api.cookiescan.io

# SQLite file for watches, price alerts and tips.
DB_PATH=./cookiebot.db

# How often price alerts are evaluated, in seconds.
PRICE_CHECK_SECONDS=60
